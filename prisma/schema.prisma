generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Template {
  id          String   @id @default(cuid())
  name        String
  description String?
  filename    String
  storedPath  String
  publicUrl   String
  widthPx     Int      @default(1920)
  heightPx    Int      @default(1080)
  isActive    Boolean  @default(true)
  // Posição padrão do cartão do QR, em px da imagem 1920×1080. Vazio = posição legada.
  qrLeft      Int?
  qrTop       Int?
  qrSize      Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  wallpapers Wallpaper[]
}

model Wallpaper {
  id           String   @id @default(cuid())
  location     String
  wifiSsid     String
  wifiPassword String
  wifiSecurity String   @default("WPA")
  qrContent    String
  storedPath   String
  publicUrl    String
  // Posição do cartão do QR usada na imagem, em px da imagem 1920×1080. Vazio = posição legada.
  qrLeft       Int?
  qrTop        Int?
  qrSize       Int?
  templateId   String
  template     Template @relation(fields: [templateId], references: [id])
  createdAt    DateTime @default(now())

  @@index([templateId])
  @@index([createdAt])
}
